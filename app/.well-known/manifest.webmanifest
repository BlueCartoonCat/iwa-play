{
  "id": "/",
  "name": "IWA Play",
  "short_name": "IWA Play",
  "description": "IWA Play iOS & MacOS screen and media receiver.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "icons": [
    {
      "src": "/icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "/icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png"
    }
  ],
  "version": "1.0.0",
  "permissions_policy": {
    "cross-origin-isolated": ["self"],
    "direct-sockets": ["self"],
    "direct-sockets-multicast": ["self"],
    "local-network": ["self"],
    "loopback-network": ["self"]
  }
}
